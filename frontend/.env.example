# URL local da API do backend.
VITE_API_URL=http://localhost:3333

# Exibe a interface de prática quando a migration do backend foi aplicada,
# o acervo foi validado e as duas flags QUESTION_PRACTICE_* do backend estão ativas.
VITE_QUESTION_PRACTICE_UI_ENABLED=false

# Exibe o diagnóstico inicial somente quando INITIAL_DIAGNOSTIC_API_ENABLED
# estiver ativo no backend após validação de schema e inventário elegível.
VITE_INITIAL_DIAGNOSTIC_UI_ENABLED=false

# OAuth 2.0 Client ID (tipo Web application) do mesmo projeto Google Cloud
# configurado em backend/.env como GOOGLE_CLIENT_ID.
# Preencha localmente; não invente um ID nem coloque segredo de cliente aqui.
VITE_GOOGLE_CLIENT_ID=

# TESTE LOCAL: substituir pelo ID do usuário autenticado quando a autenticação estiver integrada.
VITE_TEST_STUDENT_ID=11111111-1111-4111-8111-111111111111
