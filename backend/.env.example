# Ambiente exclusivamente local. Nao use URLs do Supabase compartilhado.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jurissim_local?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jurissim_local?schema=public"
PORT=3333
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="8h"
APP_PUBLIC_URL="http://localhost:5173"

# OAuth 2.0 Client ID (tipo Web application), igual a
# frontend/.env como VITE_GOOGLE_CLIENT_ID. Nunca coloque segredo de cliente aqui.
GOOGLE_CLIENT_ID=

# URL pública do frontend usada para montar links de recuperação de senha.
# Em produção, substitua pela origem HTTPS oficial do JurisSim.
APP_PUBLIC_URL=http://localhost:5173

# O seed recusa executar sem esta confirmacao e fora de localhost.
SEED_LOCAL_DATABASE=true

# Testes de integração (npm run test:integration). Banco SEPARADO e descartável:
# ele é apagado e recriado a cada execução. O nome do banco ou do schema
# precisa conter "test". Exemplos:
#   PostgreSQL local: postgresql://postgres:postgres@localhost:5432/jurissim_test
#   Supabase (schema separado): <sua DIRECT_URL>?schema=jurissim_test
TEST_DATABASE_URL=
