# Ambiente exclusivamente local. Nao use URLs do Supabase compartilhado.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jurissim?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/jurissim?schema=public
PORT=3333
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="8h"
APP_PUBLIC_URL="http://localhost:5173"

# OAuth 2.0 Client ID (tipo Web application), igual a
# frontend/.env como VITE_GOOGLE_CLIENT_ID. Nunca coloque segredo de cliente aqui.
GOOGLE_CLIENT_ID=

# URL pública do frontend usada para montar links de recuperação de senha.
# Em produção, substitua pela origem HTTPS oficial do JurisSim.
APP_PUBLIC_URL=http://localhost:5173

# O seed recusa executar sem esta confirmacao e fora de localhost.
SEED_LOCAL_DATABASE=true
# Brevo SMTP: smtp-relay.brevo.com:587, STARTTLS obrigatorio.
# Remetente fixo: JurisSim <jurissimplataforma@gmail.com>.
# Cole a chave SMTP somente no backend/.env privado; nunca use a chave da API.
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=

# Testes de integração: as URLs abaixo são injetadas somente pelo harness local.
# Execute node scripts/test-migrations-local.cjs "C:\Program Files\PostgreSQL\17\bin".
# Não preencher com Supabase ou outro banco existente. O setup exige cluster
# descartável próprio, URL loopback e prova do diretório de dados antes de SQL.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
