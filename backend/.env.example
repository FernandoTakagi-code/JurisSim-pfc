# Ambiente exclusivamente local. Nao use URLs do Supabase compartilhado.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jurissim_local?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jurissim_local?schema=public"
PORT=3333
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
