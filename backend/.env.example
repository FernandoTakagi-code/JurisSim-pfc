# Ambiente compartilhado de desenvolvimento. Obtenha as URLs do Supabase
# pelo canal seguro da equipe; nunca grave credenciais reais neste arquivo.
NODE_ENV=development
HOST=0.0.0.0
# Sem proxy local: 0. No Render, omitir usa 1. Ajuste à cadeia real de proxies.
# Nunca use trust proxy=true indiscriminadamente.
# TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://USER:PASSWORD@SUPABASE_POOLER_HOST:6543/postgres?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@SUPABASE_DIRECT_HOST:5432/postgres?schema=public&sslmode=require
PORT=3333
JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
# A validade atual do token é de 8 horas, definida no serviço de autenticação.
APP_PUBLIC_URL="http://localhost:5173"

# Origens de navegador autorizadas a chamar a API (origens exatas, separadas por vírgula).
# Adicione aqui a origem HTTPS exata de homologação quando existir; não use curingas.
CORS_ORIGINS=http://localhost:5173

# Diagnóstico inicial: habilite a API somente depois que a migração, o inventário elegível
# e as verificações de integração em PostgreSQL descartável tiverem passado. Para exigi-lo
# antes do estudo, habilite também INITIAL_DIAGNOSTIC_REQUIRED. A API tem controle próprio.
INITIAL_DIAGNOSTIC_REQUIRED=false
INITIAL_DIAGNOSTIC_API_ENABLED=false
# Modo padrão preservado; AUTORAL_30 é a proposta para ensaio isolado.
# Escolher o modo não habilita a API nem dispensa revisões e liberação.
INITIAL_DIAGNOSTIC_COMPOSITION_MODE=MISTA_15_15
# Piloto explicitamente autorizado de um lote em revisão, separado do acervo liberado.
INITIAL_DIAGNOSTIC_PILOT_ENABLED=false
INITIAL_DIAGNOSTIC_PILOT_BATCH_ID=

# A prática individual de questões exige a migração do schema e a liberação da API.
# Habilite somente após aplicar as migrações e validar o inventário elegível no PostgreSQL.
QUESTION_PRACTICE_SCHEMA_ENABLED=false
QUESTION_PRACTICE_API_ENABLED=false
# Autorização explícita do proprietário, apenas para prática. Usa liberações auditadas;
# nunca simula revisão jurídica nem altera a elegibilidade em simulados/diagnósticos.
QUESTION_PRACTICE_OWNER_AUTHORIZATION_ENABLED=false
QUESTION_PRACTICE_PILOT_ENABLED=false
QUESTION_PRACTICE_PILOT_BATCH_ID=
# Lista opcional de permissões separada por vírgula (até 10 UUIDs); substitui o ID único.
QUESTION_PRACTICE_PILOT_BATCH_IDS=

# Sessões de revisão separadas; habilite somente após aplicar a migração de revisão.
QUESTION_REVIEW_SCHEMA_ENABLED=false
QUESTION_REVIEW_API_ENABLED=false
# As rotas editoriais opcionais existentes permanecem desativadas por padrão.
QUESTION_EDITORIAL_WRITES_ENABLED=false

# Simulados individuais mistos: habilite o schema somente após aplicar sua migração.
INDIVIDUAL_EXAM_SCHEMA_ENABLED=false
INDIVIDUAL_EXAM_API_ENABLED=false
INDIVIDUAL_EXAM_PILOT_ENABLED=false
INDIVIDUAL_EXAM_PILOT_BATCH_ID=
INDIVIDUAL_EXAM_PILOT_BATCH_IDS=

# Diagnóstico de erros opcional, somente local, para estas rotas GET dos painéis.
# Exige NODE_ENV=development e cliente/servidor em loopback; desativado por padrão.
# LOCAL_DASHBOARD_ERROR_DIAGNOSTICS=1

# OAuth 2.0 Client ID (tipo Web application), igual a
# frontend/.env como VITE_GOOGLE_CLIENT_ID. Nunca coloque segredo de cliente aqui.
GOOGLE_CLIENT_ID=

# URL pública do frontend usada para montar links de recuperação de senha.
# Em produção, substitua pela origem HTTPS oficial do JurisSim.

# O seed recusa executar sem esta confirmacao e fora de localhost.
SEED_LOCAL_DATABASE=false
# Brevo API v3 por HTTPS (transporte principal). Configure a chave somente em
# backend/.env privado ou no gerenciador de segredos do ambiente; nunca versione.
BREVO_EMAIL_TRANSPORT=api
BREVO_API_KEY=

# Alternativa SMTP explícita: use BREVO_EMAIL_TRANSPORT=smtp.
# O remetente fixo está definido no serviço de e-mail; não use as credenciais SMTP como remetente.
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=

# Testes de integração: as URLs abaixo são injetadas somente pelo harness local.
# Execute node scripts/test-migrations-local.cjs "C:\Program Files\PostgreSQL\17\bin".
# Não preencher com Supabase ou outro banco existente. O setup exige cluster
# descartável próprio, URL loopback e prova do diretório de dados antes de SQL.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# Administração institucional: ative somente depois da migration autorizada.
INSTITUTIONS_ENABLED=false
# Escopo independente: convites e vínculos de professores em instituições
# ativas; não libera atividades, simulados, turmas ou ciclo de vida.
INSTITUTION_TEACHER_MANAGEMENT_ENABLED=false
INSTITUTION_EXAM_MANAGEMENT_ENABLED=false
# Somente desenvolvimento: o envio de convites também exige um modo explícito.
# Em produção, defina NODE_ENV=production e TEACHER_INVITATIONS_MODE=production
# no gerenciador de segredos após configurar a URL HTTPS pública e o Brevo.
NODE_ENV=development
TEACHER_INVITATIONS_MODE=institutional
# Capacidades independentes, também desativadas por padrão. Habilitar somente
# após conferir o schema e receber autorização específica para o ambiente.
ADMINISTRATION_ENABLED=false
INSTITUTION_REGISTRATION_ENABLED=false
# Retenção operacional da auditoria (30 a 3650 dias); não executa expurgo automático.
AUDIT_RETENTION_DAYS=180

# Opcional: enriquecimento de justificativas. O fluxo deve funcionar sem esta chave.
GROQ_API_KEY=

# Atividades: permitir somente lotes piloto explicitamente autorizados.
# Conteúdo e resultados continuam identificados como provisórios, sem aprovar revisões.
CLASS_ACTIVITY_PILOT_ENABLED=false
CLASS_ACTIVITY_PILOT_BATCH_IDS=
