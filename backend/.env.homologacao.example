# Apenas preparação da H1. Copie localmente; nunca reutilize as credenciais principais.
JURISSIM_ENV=homologacao
# Referência do projeto confirmada pelo proprietário no painel separado do Supabase.
HOMOLOGACAO_PROJECT_REF=
# Use as strings de conexão exatas do NOVO projeto; codifique a senha para URL.
# Execução: conexão direta/pooler de sessão :5432, ou de transação :6543 com pgbouncer=true.
# As duas URLs: schema=public&sslmode=require&sslaccept=strict.
# Se necessário, baixe a CA do NOVO projeto para backend/.local/homologacao/supabase-ca.crt
# e acrescente sslcert=../.local/homologacao/supabase-ca.crt (relativo a prisma/).
DATABASE_URL=
# Preferir conexão direta :5432; pooler de sessão :5432 quando não houver IPv6.
DIRECT_URL=
# Gerado localmente pelo comando de preparação; nunca copiado de backend/.env.
JWT_SECRET=
JWT_EXPIRES_IN=1h
NODE_ENV=development
HOST=127.0.0.1
PORT=3340
APP_PUBLIC_URL=http://127.0.0.1:5180
CORS_ORIGINS=http://127.0.0.1:5180
# Permanecem desativados na H1. A ativação futura exige aprovação separada.
INSTITUTION_REGISTRATION_ENABLED=false
ADMINISTRATION_ENABLED=false
INSTITUTIONS_ENABLED=false
BREVO_EMAIL_TRANSPORT=disabled
BREVO_API_KEY=
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
GOOGLE_CLIENT_ID=
LOCAL_EMAIL_CAPTURE_ENABLED=false
LOCAL_DIAGNOSTIC_DEMO_MODE=false
INITIAL_DIAGNOSTIC_REQUIRED=false
INITIAL_DIAGNOSTIC_API_ENABLED=false
QUESTION_PRACTICE_SCHEMA_ENABLED=false
QUESTION_PRACTICE_API_ENABLED=false
