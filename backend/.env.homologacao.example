# H1 preparation only. Copy locally; never reuse principal credentials.
JURISSIM_ENV=homologacao
# Project ref confirmed by the owner in the separate Supabase dashboard.
HOMOLOGACAO_PROJECT_REF=
# Use exact Connect strings from the NEW project; URL-encode its password.
# Runtime: direct/session pooler :5432, or transaction :6543 with pgbouncer=true.
# Both URLs: schema=public&sslmode=require&sslaccept=strict.
# If needed, download the NEW project's CA to backend/.local/homologacao/supabase-ca.crt
# and append sslcert=../.local/homologacao/supabase-ca.crt (relative to prisma/).
DATABASE_URL=
# Direct :5432 preferred; session pooler :5432 when IPv6 is unavailable.
DIRECT_URL=
# Generated locally by the prepare command; never copied from backend/.env.
JWT_SECRET=
JWT_EXPIRES_IN=1h
NODE_ENV=development
HOST=127.0.0.1
PORT=3340
APP_PUBLIC_URL=http://127.0.0.1:5180
CORS_ORIGINS=http://127.0.0.1:5180
# Remain disabled in H1. Future activation needs separate approval.
INSTITUTION_REGISTRATION_ENABLED=false
ADMINISTRATION_ENABLED=false
INSTITUTIONS_ENABLED=false
BREVO_EMAIL_TRANSPORT=disabled
BREVO_API_KEY=
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
GOOGLE_CLIENT_ID=
LOCAL_EMAIL_CAPTURE_ENABLED=false
LOCAL_DIAGNOSTIC_DEMO_MODE=false
INITIAL_DIAGNOSTIC_REQUIRED=false
INITIAL_DIAGNOSTIC_API_ENABLED=false
QUESTION_PRACTICE_SCHEMA_ENABLED=false
QUESTION_PRACTICE_API_ENABLED=false
