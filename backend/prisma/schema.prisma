generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  registrationIntent               String?
  invitationOnboarding InvitationOnboarding?
  id                  String       @id @default(uuid())
  nome                String
  email               String       @unique
  senhaHash           String?
  sessionVersion      Int          @default(0)
  role                Role
  createdAt           DateTime     @default(now())
  nivelAtual          Nivel?
  legalAcceptedAt     DateTime?
  termsVersion        String?
  privacyVersion      String?
  emailVerifiedAt     DateTime?
  deletedAt           DateTime?
  auditLogs           AuditLog[]
  authTokens          AuthToken[]
  recoveryTokens      PasswordRecoveryToken[]
  metasDiarias        MetaDiaria[]
  questoesCriadas     Questao[]
  simulados           Simulado[]
  revisoesQuestoes    SessaoRevisaoQuestao[]
  turmasComoAluno     Turma[]      @relation("AlunoTurmas")
  turmasComoProfessor Turma[]      @relation("ProfessorTurmas")
  avaliacoesCriadas   Avaliacao[]
  profilePhotos       ProfilePhoto[]
  lotesQuestoesImportadas LoteImportacao[]
  diagnosticoInicial DiagnosticoInicial?
  questoesRevisadasJuridicamente Questao[] @relation("RevisorJuridicoQuestao")
  questoesRevisadasPedagogicamente Questao[] @relation("RevisorPedagogicoQuestao")
  questoesLiberadasAcervo Questao[] @relation("LiberadorAcervoQuestao")
  questoesDireitosVerificados Questao[] @relation("VerificadorDireitosQuestao")
  institutionsOwned Institution[]
  institutionalMemberships InstitutionalMembership[]
  teacherInvitationsAccepted TeacherInvitation[]
  classJoinRequests ClassJoinRequest[]
  accountControl AccountControl?
  administrativeEvents AdministrativeEvent[]
  administrativeNotifications AdministrativeNotification[]
  questoesDocentesCriadas          QuestaoDocente[]
  materiaisDocentes                MaterialTurma[]
  avisosDocentes                   AvisoTurma[]
  atividadesCriadas                Atividade[]
  entregasAtividade                EntregaAtividade[]
}

// At most one private photo per user (primary key). List relation allows atomic
// deleteMany during account anonymization even if no photo has been chosen.
model ProfilePhoto {
  userId    String @id
  avatarId  String?
  image     Bytes?
  version   String @default(uuid())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
}

model PasswordRecoveryToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Turma {
  activities ClassActivity[]
  lifecycle ClassLifecycle?
  invitationAssignments TeacherInvitationClass[]
  id            String    @id @default(uuid())
  nome          String
  codigoConvite String    @unique
  createdAt     DateTime  @default(now())
  archivedAt    DateTime?
  conviteExpiraEm DateTime?
  avaliacoes    Avaliacao[]
  questoes      Questao[]
  alunos        User[]    @relation("AlunoTurmas")
  professores   User[]    @relation("ProfessorTurmas")
  institutionalClass InstitutionalClass?
  joinRequests ClassJoinRequest[]
  questoesDocentes      QuestaoDocenteTurma[]
  atividades            AtividadeTurma[]
  materiais             MaterialTurma[]
  avisos                AvisoTurma[]
}

// Separate optional metadata keeps deployments compatible before migration.
// Historical ownership is never inferred from current teacher assignments.
model ClassLifecycle {
  classId String @id
  createdById String?
  deletedAt DateTime?
  deletedById String?
  turma Turma @relation(fields: [classId], references: [id], onDelete: Restrict)
  @@index([deletedAt])
}

model Questao {
  id                    String            @id @default(uuid())
  enunciado             String
  disciplina            String
  assunto               String
  nivel                 Nivel
  fundamentacaoJuridica String
  publica               Boolean           @default(true)
  createdAt             DateTime          @default(now())
  turmaId               String?
  autorId               String
  fonteNome             String?
  fonteReferencia       String?
  licencaOuAutorizacao  String?
  loteImportacaoId      String?
  // Historical records remain NULL until a duplicate-aware, reviewed backfill.
  fingerprint           String?           @unique(map: "Questao_fingerprint_key")
  origem                OrigemQuestao?
  revisaoJuridicaEm     DateTime?
  revisorJuridicoId     String?
  revisaoPedagogicaEm   DateTime?
  revisorPedagogicoId   String?
  liberadaAcervoEm      DateTime?
  liberadaAcervoPorId   String?
  situacaoDireitos      SituacaoDireitos?
  direitosVerificadosEm DateTime?
  direitosVerificadosPorId String?
  oabExame              String?
  oabEdicao             String?
  oabTipoProva          String?
  oabNumeroQuestao      Int?
  fonteOficialUrl       String?
  situacaoQuestaoOficial SituacaoQuestaoOficial?
  alternativas          Alternativa[]
  autor                 User              @relation(fields: [autorId], references: [id])
  revisorJuridico       User?             @relation("RevisorJuridicoQuestao", fields: [revisorJuridicoId], references: [id], onDelete: Restrict)
  revisorPedagogico     User?             @relation("RevisorPedagogicoQuestao", fields: [revisorPedagogicoId], references: [id], onDelete: Restrict)
  liberadorAcervo       User?             @relation("LiberadorAcervoQuestao", fields: [liberadaAcervoPorId], references: [id], onDelete: Restrict)
  verificadorDireitos   User?             @relation("VerificadorDireitosQuestao", fields: [direitosVerificadosPorId], references: [id], onDelete: Restrict)
  turma                 Turma?            @relation(fields: [turmaId], references: [id])
  loteImportacao        LoteImportacao?   @relation(fields: [loteImportacaoId], references: [id], onDelete: Restrict)
  diagnosticos          QuestaoSimulado[]
  respostas             Resposta[]
  avaliacoes            AvaliacaoQuestao[]

  @@index([origem, disciplina, nivel], map: "Questao_origem_disciplina_nivel_idx")
  atividades               AtividadeQuestao[]
}

model LoteImportacao {
  id              String    @id @default(uuid())
  administradorId String
  importadoEm     DateTime  @default(now())
  arquivoHash     String    @db.Char(64)
  totalQuestoes   Int
  administrador   User      @relation(fields: [administradorId], references: [id], onDelete: Restrict)
  questoes        Questao[]

  @@index([administradorId, importadoEm])
}

model Alternativa {
  id        String  @id @default(uuid())
  texto     String
  correta   Boolean
  questaoId String
  letra     LetraAlternativa?
  questao   Questao @relation(fields: [questaoId], references: [id])

  @@unique([questaoId, letra], map: "Alternativa_questaoId_letra_key")
}

model Simulado {
  id                     String                  @id @default(uuid())
  tipo                   TipoSimulado
  iniciadoEm             DateTime                @default(now())
  finalizadoEm           DateTime?
  tempoLimiteSegundos    Int?
  alunoId                String
  avaliacaoId            String?
  avaliacao              Avaliacao? @relation(fields: [avaliacaoId], references: [id], onDelete: Restrict)
  desempenhosDiagnostico DesempenhoDiagnostico[]
  questoes               QuestaoSimulado[]
  respostas              Resposta[]
  aluno                  User                    @relation(fields: [alunoId], references: [id])
  trilhaOrigem           TrilhaAdaptativa?       @relation("TrilhaGerouExercicios")
  trilhaAdaptativa       TrilhaAdaptativa?       @relation("TrilhaDoDiagnostico")
  diagnosticoInicial     DiagnosticoInicial?     @relation("DiagnosticoInicialSimulado")
  sessaoPratica          SessaoPratica?          @relation("SessaoPraticaSimulado")
  sessaoIndividual       SessaoSimuladoIndividual? @relation("SessaoIndividualSimulado")

  @@index([alunoId, iniciadoEm, id])
  @@index([alunoId, finalizadoEm, id])
  @@unique([avaliacaoId, alunoId])
  // Supports a composite FK that guarantees the initial diagnostic belongs to its recorded student.
  @@unique([id, alunoId], map: "Simulado_id_alunoId_key")
  questoesDocentes       QuestaoSimuladoDocente[]
}

model DiagnosticoInicial {
  id         String   @id @default(uuid())
  alunoId    String   @unique
  simuladoId String   @unique
  aluno      User     @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  simulado   Simulado @relation("DiagnosticoInicialSimulado", fields: [simuladoId, alunoId], references: [id, alunoId], onDelete: Restrict)

  // Prisma requires a unique key matching the composite one-to-one relation.
  // The individual simuladoId unique constraint remains an explicit invariant.
  @@unique([simuladoId, alunoId], map: "DiagnosticoInicial_simuladoId_alunoId_key")
}

model SessaoPratica {
  id         String   @id @default(uuid())
  simuladoId String   @unique
  alunoId    String
  disciplina String
  assunto    String?
  criadaEm   DateTime @default(now())
  simulado   Simulado @relation("SessaoPraticaSimulado", fields: [simuladoId, alunoId], references: [id, alunoId], onDelete: Restrict)

  @@unique([simuladoId, alunoId], map: "SessaoPratica_simuladoId_alunoId_key")
  @@index([alunoId, criadaEm])
}

model SessaoSimuladoIndividual {
  id         String @id @default(uuid())
  simuladoId String @unique
  alunoId    String
  criadaEm   DateTime @default(now())
  simulado   Simulado @relation("SessaoIndividualSimulado", fields: [simuladoId, alunoId], references: [id, alunoId], onDelete: Restrict, map: "SessaoIndividual_simuladoId_alunoId_fkey")

  @@unique([simuladoId, alunoId], map: "SessaoIndividual_simuladoId_alunoId_key")
  @@index([alunoId, criadaEm], map: "SessaoIndividual_alunoId_criadaEm_idx")
}
model SessaoRevisaoQuestao {
  id            String   @id @default(uuid())
  alunoId       String
  disciplina    String
  assunto       String?
  filtro        String
  conteudo      Json
  respostas     Json     @default("{}")
  criadaEm      DateTime @default(now())
  finalizadaEm  DateTime?
  aluno         User     @relation(fields: [alunoId], references: [id], onDelete: Restrict, map: "SessaoRevisaoQuestao_alunoId_fkey")

  @@index([alunoId, criadaEm])
}

model Avaliacao {
  settings ClassExamSettings?
  activity ClassActivity?
  id String @id @default(uuid())
  titulo String
  descricao String @default("")
  duracaoSegundos Int?
  createdAt DateTime @default(now())
  publishedAt DateTime?
  autorId String
  autor User @relation(fields: [autorId], references: [id], onDelete: Restrict)
  turmas Turma[]
  questoes AvaliacaoQuestao[]
  tentativas Simulado[]

  @@index([autorId, createdAt, id])
  questoesDocentes AvaliacaoQuestaoDocente[]
}

// Activity scheduling/lifecycle is distinct; assessment questions and attempts
// reuse the existing engine without copying student answers or results.
model ClassActivity {
  id String @id @default(uuid())
  evaluationId String @unique
  classId String
  dueAt DateTime?
  maxPoints Float @default(10)
  closedAt DateTime?
  cancelledAt DateTime?
  avaliacao Avaliacao @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  turma Turma @relation(fields: [classId], references: [id], onDelete: Restrict)
  @@index([classId, dueAt, id])
}

model ClassExamSettings {
  evaluationId String @id
  expectedQuestions Int
  closedAt DateTime?
  archivedAt DateTime?
  avaliacao Avaliacao @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
}

model AvaliacaoQuestao {
  id String @id @default(uuid())
  avaliacaoId String
  questaoId String
  posicao Int
  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Restrict)
  questao Questao @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  @@unique([avaliacaoId, questaoId])
  @@unique([avaliacaoId, posicao])
  @@index([questaoId])
  conteudoSnapshot Json? @db.JsonB
}

model Resposta {
  id                     String           @id @default(uuid())
  correta                Boolean
  tempoRespostaSegundos  Int?
  respondidoEm           DateTime         @default(now())
  simuladoId             String
  questaoId              String
  alternativaEscolhidaId String?
  questaoSimuladoId      String?          @unique
  questao                Questao          @relation(fields: [questaoId], references: [id])
  questaoSimulado        QuestaoSimulado? @relation("RespostaDiagnostico", fields: [questaoSimuladoId], references: [id])
  simulado               Simulado         @relation(fields: [simuladoId], references: [id])

  @@index([simuladoId, respondidoEm])
}

model QuestaoSimulado {
  id         String    @id @default(uuid())
  posicao    Int
  simuladoId String
  questaoId  String
  // Optional historical content snapshot. NULL for attempts created before this field.
  conteudoSnapshot Json? @db.JsonB
  questao    Questao   @relation(fields: [questaoId], references: [id])
  simulado   Simulado  @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  resposta   Resposta? @relation("RespostaDiagnostico")

  @@unique([simuladoId, questaoId])
  @@unique([simuladoId, posicao])
}

model DesempenhoDiagnostico {
  id            String                 @id @default(uuid())
  simuladoId    String
  tipo          TipoMetricaDiagnostico
  disciplina    String
  assunto       String?
  nivel         Nivel?
  acertos       Int
  totalQuestoes Int
  percentual    Float
  simulado      Simulado               @relation(fields: [simuladoId], references: [id], onDelete: Cascade)

  @@index([simuladoId, tipo])
}

model MetaDiaria {
  id                 String   @id @default(uuid())
  data               DateTime
  metaQuestoes       Int
  questoesResolvidas Int      @default(0)
  cumprida           Boolean  @default(false)
  alunoId            String
  aluno              User     @relation(fields: [alunoId], references: [id])

  @@index([alunoId, data, id])
}

model TrilhaAdaptativa {
  id                    String    @id @default(uuid())
  simuladoId            String    @unique
  disciplinaPrioritaria String
  assuntoPrioritario    String?
  nivelRecomendado      Nivel
  quantidadeRecomendada Int
  justificativa         String
  createdAt             DateTime  @default(now())
  simuladoGeradoId      String?   @unique
  simuladoGerado        Simulado? @relation("TrilhaGerouExercicios", fields: [simuladoGeradoId], references: [id])
  simulado              Simulado  @relation("TrilhaDoDiagnostico", fields: [simuladoId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String      @id @default(uuid())
  userId         String?
  action         AuditAction
  occurredAt     DateTime    @default(now())
  termsVersion   String?
  privacyVersion String?
  resourceId     String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

model Institution {
  id String @id @default(uuid())
  name String
  registrationNumber String? @unique
  responsibleName String
  tradeName String?
  address String?
  representativePosition String?
  contactEmail String?
  institutionType String?
  postalCode String?
  street String?
  number String?
  addressComplement String?
  district String?
  city String?
  state String?
  website String?
  representativePhone String?
  representationDeclaration Boolean?
  representationDeclaredAt DateTime?
  representationDeclarationVersion String?
  representationEvidence String?
  ownerId String
  email String @unique
  phone String
  description String
  status String @default("PENDING")
  decisionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  events AdministrativeEvent[]
  memberships InstitutionalMembership[]
  invitations TeacherInvitation[]
  classes InstitutionalClass[]
  @@index([ownerId, status])
  @@index([status, createdAt, id])
}

model InstitutionalMembership {
  id String @id @default(uuid())
  institutionId String
  userId String
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  @@unique([institutionId, userId, role])
  @@index([userId, active])
}

model TeacherInvitation {
  id String @id @default(uuid())
  institutionId String
  email String
  invitedName String?
  classAssignments TeacherInvitationClass[]
  onboarding InvitationOnboarding?
  tokenHash String @unique
  status String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  sentAt DateTime?
  acceptedById String?
  acceptedBy User? @relation(fields: [acceptedById], references: [id], onDelete: Restrict)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  @@index([institutionId, createdAt, id])
}

model TeacherInvitationClass {
  invitationId String
  classId String
  invitation TeacherInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  turma Turma @relation(fields: [classId], references: [id], onDelete: Restrict)
  @@id([invitationId, classId])
  @@index([classId])
}

model InvitationOnboarding {
  id String @id @default(uuid())
  invitationId String @unique
  userId String @unique
  proofHash String @unique
  initialPasswordHash String
  expiresAt DateTime
  completedAt DateTime?
  lastSentAt DateTime @default(now())
  sendAttempts Int @default(1)
  createdAt DateTime @default(now())
  invitation TeacherInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model InstitutionalClass {
  classId String @id
  institutionId String
  turma Turma @relation(fields: [classId], references: [id], onDelete: Restrict)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  @@index([institutionId])
}

model ClassJoinRequest {
  id String @id @default(uuid())
  classId String
  studentId String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  turma Turma @relation(fields: [classId], references: [id], onDelete: Restrict)
  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([classId, studentId])
  @@index([classId, status, createdAt, id])
}

model AccountControl {
  userId String @id
  suspended Boolean @default(false)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Persistent administrative decision about whether a deleted identity's
// normalized e-mail may create a new, unrelated account. It deliberately has
// no FK to User: the deleted identity can be anonymized while this retention
// record remains auditable and enforceable.
model EmailReuseBlock {
  id              String    @id @default(uuid())
  emailNormalized String    @unique
  createdAt       DateTime  @default(now())
  createdById     String?
  reason          String?
  revokedAt       DateTime?
  revokedById     String?

  @@index([revokedAt])
}

model AdministrativeEvent {
  id String @id @default(uuid())
  occurredAt DateTime @default(now())
  event String
  actorId String?
  institutionId String?
  resourceId String?
  result String
  severity String @default("INFO")
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  @@index([institutionId, occurredAt, id])
  @@index([actorId, occurredAt, id])
  @@index([event, occurredAt, id])
}

model AdministrativeNotification {
  id String @id @default(uuid())
  userId String
  message String
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt, id])
}

enum Nivel {
  BASICO
  INTERMEDIARIO
  AVANCADO
}

enum OrigemQuestao {
  IA
  OAB_OFICIAL
  PROFESSOR
}

enum SituacaoDireitos {
  NAO_VERIFICADO
  AUTORIZADA
  DOMINIO_PUBLICO_VERIFICADO
  NEGADA
}

enum SituacaoQuestaoOficial {
  VALIDA
  ANULADA
}

enum LetraAlternativa {
  A
  B
  C
  D
}

enum TipoSimulado {
  DIAGNOSTICO
  PERSONALIZADO
  AVALIACAO
}

enum TipoMetricaDiagnostico {
  DISCIPLINA
  ASSUNTO
  NIVEL
  ASSUNTO_E_NIVEL
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  ACEITE_TERMOS_E_PRIVACIDADE
  USUARIO_CADASTRADO
  LOGIN_SUCESSO
  LOGIN_FALHA
  DIAGNOSTICO_INICIADO
  DIAGNOSTICO_FINALIZADO
  QUESTAO_CRIADA
  QUESTAO_ATUALIZADA
  QUESTAO_EXCLUIDA
  // Preserve values introduced by the historical password-recovery migration.
  PASSWORD_RECOVERY_REQUESTED
  PASSWORD_RECOVERY_COMPLETED
  EMAIL_CONFIRMADO
  SENHA_REDEFINIDA
  CONTA_EXCLUIDA
  RECUPERACAO_SENHA_SOLICITADA
}

model QuestaoDocente {
  id            String                    @id @default(uuid())
  autorId       String
  institutionId String?
  tipo          String
  enunciado     String
  disciplina    String
  assunto       String
  nivel         Nivel?
  fundamentacao String?
  arquivadaEm   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  autor         User                      @relation(fields: [autorId], references: [id], onDelete: Restrict)
  alternativas  AlternativaDocente[]
  turmas        QuestaoDocenteTurma[]
  atividades    AtividadeQuestao[]
  avaliacoes    AvaliacaoQuestaoDocente[]
  tentativas    QuestaoSimuladoDocente[]

  @@index([autorId, arquivadaEm, updatedAt])
  @@index([institutionId, arquivadaEm])
}

model AlternativaDocente {
  id        String         @id @default(uuid())
  questaoId String
  letra     String
  texto     String
  correta   Boolean        @default(false)
  questao   QuestaoDocente @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  @@unique([questaoId, letra])
  @@index([questaoId])
}

model QuestaoDocenteTurma {
  questaoId String
  classId   String
  questao   QuestaoDocente @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  turma     Turma          @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@id([questaoId, classId])
  @@index([classId])
}

model MaterialTurma {
  id          String   @id @default(uuid())
  classId     String
  professorId String
  titulo      String
  descricao   String   @default("")
  url         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  turma       Turma    @relation(fields: [classId], references: [id], onDelete: Restrict)
  professor   User     @relation(fields: [professorId], references: [id], onDelete: Restrict)

  @@index([classId, createdAt, id])
  @@index([professorId, updatedAt])
}

model AvisoTurma {
  id          String   @id @default(uuid())
  classId     String
  professorId String
  titulo      String
  conteudo    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  turma       Turma    @relation(fields: [classId], references: [id], onDelete: Restrict)
  professor   User     @relation(fields: [professorId], references: [id], onDelete: Restrict)

  @@index([classId, createdAt, id])
  @@index([professorId, updatedAt])
}

model Atividade {
  id            String             @id @default(uuid())
  professorId   String
  institutionId String?
  titulo        String
  descricao     String             @default("")
  status        String             @default("RASCUNHO")
  prazo         DateTime?
  publicadaEm   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  professor     User               @relation(fields: [professorId], references: [id], onDelete: Restrict)
  turmas        AtividadeTurma[]
  questoes      AtividadeQuestao[]
  entregas      EntregaAtividade[]

  @@index([professorId, status, updatedAt])
  @@index([institutionId, status])
}

model AtividadeTurma {
  atividadeId String
  classId     String
  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Restrict)
  turma       Turma     @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@id([atividadeId, classId])
  @@index([classId])
}

model AtividadeQuestao {
  id               String              @id @default(uuid())
  atividadeId      String
  questaoId        String?
  questaoDocenteId String?
  posicao          Int
  pontos           Decimal             @default(1) @db.Decimal(8, 2)
  conteudoSnapshot Json                @db.JsonB
  atividade        Atividade           @relation(fields: [atividadeId], references: [id], onDelete: Restrict)
  questao          Questao?            @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  questaoDocente   QuestaoDocente?     @relation(fields: [questaoDocenteId], references: [id], onDelete: Restrict)
  respostas        RespostaAtividade[]

  @@unique([atividadeId, posicao])
  @@unique([atividadeId, questaoId])
  @@unique([atividadeId, questaoDocenteId])
  @@index([questaoId])
  @@index([questaoDocenteId])
}

model EntregaAtividade {
  id          String              @id @default(uuid())
  atividadeId String
  alunoId     String
  status      String              @default("RASCUNHO")
  iniciadaEm  DateTime            @default(now())
  enviadaEm   DateTime?
  corrigidaEm DateTime?
  liberadaEm  DateTime?
  atividade   Atividade           @relation(fields: [atividadeId], references: [id], onDelete: Restrict)
  aluno       User                @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  respostas   RespostaAtividade[]

  @@unique([atividadeId, alunoId])
  @@index([atividadeId, status, enviadaEm])
  @@index([alunoId, iniciadaEm])
}

model RespostaAtividade {
  id                   String           @id @default(uuid())
  entregaId            String
  atividadeQuestaoId   String
  respostaObjetiva     String?
  respostaDissertativa String?
  correta              Boolean?
  pontos               Decimal?         @db.Decimal(8, 2)
  feedback             String?
  respondidaEm         DateTime         @updatedAt
  entrega              EntregaAtividade @relation(fields: [entregaId], references: [id], onDelete: Restrict)
  atividadeQuestao     AtividadeQuestao @relation(fields: [atividadeQuestaoId], references: [id], onDelete: Restrict)

  @@unique([entregaId, atividadeQuestaoId])
  @@index([atividadeQuestaoId])
}

model AvaliacaoQuestaoDocente {
  id               String         @id @default(uuid())
  avaliacaoId      String
  questaoDocenteId String
  posicao          Int
  conteudoSnapshot Json?          @db.JsonB
  avaliacao        Avaliacao      @relation(fields: [avaliacaoId], references: [id], onDelete: Restrict)
  questaoDocente   QuestaoDocente @relation(fields: [questaoDocenteId], references: [id], onDelete: Restrict)

  @@unique([avaliacaoId, questaoDocenteId])
  @@unique([avaliacaoId, posicao])
  @@index([questaoDocenteId])
}

model QuestaoSimuladoDocente {
  id               String                   @id @default(uuid())
  posicao          Int
  simuladoId       String
  questaoDocenteId String
  conteudoSnapshot Json                     @db.JsonB
  questaoDocente   QuestaoDocente           @relation(fields: [questaoDocenteId], references: [id], onDelete: Restrict)
  simulado         Simulado                 @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  resposta         RespostaSimuladoDocente?

  @@unique([simuladoId, questaoDocenteId])
  @@unique([simuladoId, posicao])
  @@index([questaoDocenteId])
}

model RespostaSimuladoDocente {
  id                       String                 @id @default(uuid())
  questaoSimuladoDocenteId String                 @unique
  alternativaEscolhidaId   String?
  correta                  Boolean
  respondidoEm             DateTime               @default(now())
  questaoSimuladoDocente   QuestaoSimuladoDocente @relation(fields: [questaoSimuladoDocenteId], references: [id], onDelete: Restrict)
}
